# Application
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# SQL Server
SA_PASSWORD=W0rksh0p@Fiap2026!

# Connection String (uses service name 'sqlserver' as host inside docker-compose)
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=Fiap_Workshop;User Id=sa;Password=W0rksh0p@Fiap2026!;TrustServerCertificate=True;

# JWT
Jwt__SecretKey=CHANGE_THIS_SECRET_KEY_MIN_32_CHARS_IN_PRODUCTION!
Jwt__Issuer=Fiap.Workshop
Jwt__Audience=Fiap.Workshop
Jwt__ExpirationInMinutes=15
Jwt__RefreshTokenExpirationInDays=7

# Webhook de decisão de orçamento (chave enviada pelo sistema externo no header X-Api-Key)
Webhooks__ApiKey=CHANGE_THIS_WEBHOOK_API_KEY_IN_PRODUCTION

# E-mail (padrão: Mailpit do docker-compose, sem autenticação; caixa de entrada em http://localhost:8025)
# Para um provedor real, informe host/porta (587 + StartTls), usuário e senha.
Email__Host=mailpit
Email__Port=1025
Email__SecureSocketOptions=Auto
Email__FromAddress=nao-responda@oficina-fiap.local
Email__FromName=Oficina FIAP
Email__Username=
Email__Password=
