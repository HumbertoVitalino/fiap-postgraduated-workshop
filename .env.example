# Application
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080

# SQL Server
SA_PASSWORD=YourStrong@Passw0rd

# Connection String (uses service name 'sqlserver' as host inside docker-compose)
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=AppDb;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;

# JWT
Jwt__SecretKey=your-secret-key-with-at-least-32-characters!!
Jwt__Issuer=your-issuer
Jwt__Audience=your-audience
Jwt__ExpirationInMinutes=60
