{
  "$schema": "http://json.schemastore.org/template",
  "author": "HumbertoVitalino",
  "classifications": ["Web", "API"],
  "identity": "HumbertoVitalino.CleanArchitecture.Template",
  "name": "Clean Architecture API",
  "description": "A .NET 10 Clean Architecture template with DDD, JWT auth, EF Core SQL Server, integration tests and Docker support.",
  "shortName": "clean-arch",
  "language": "C#",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "Fiap.Workshop",
  "preferNameDirectory": true,
  "sources": [
    {
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/.vs/**",
        "**/.idea/**",
        ".git/**",
        ".env",
        "**/*.user",
        "template.csproj",
        "**/*.trx",
        "**/TestResults/**",
        "PLAN.md",
        "CONTEXT.md"
      ]
    }
  ]
}
